{
  "name": "@codecitadel/symbol-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript module graph and impact analysis: which tests can see a change",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
