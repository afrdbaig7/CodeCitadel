@@ -0,0 +1,22 @@
+-- The application check cannot stop two concurrent inserts from both passing:
+-- that is the race the reproduction reports. The constraint belongs here,
+-- where the database serializes them.
+--
+-- Existing duplicates are removed explicitly rather than silently: the earliest
+-- redemption (by redeemed_at, then by id) is kept, and every later one for the
+-- same user and coupon is deleted, so the unique index can be created.
+
+with ranked as (
+  select id,
+         row_number() over (
+           partition by user_id, coupon_id
+           order by redeemed_at, id
+         ) as position
+    from redemptions
+)
+delete from redemptions r
+  using ranked k
+ where r.id = k.id and k.position > 1;
+
+create unique index redemptions_one_per_user_coupon
+  on redemptions (user_id, coupon_id);
