{
  "name": "codecitadel-example-shopping-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo shopping API with a deliberately vulnerable coupon redemption flow",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
